# Stage 1: Build the React app
# Keep the frontend build runtime aligned with CI and Render.
FROM node:24.20.0 AS build
WORKDIR /app

ARG VITE_USE_STATIC_MENU
ENV VITE_USE_STATIC_MENU=${VITE_USE_STATIC_MENU}

COPY roast66/package.json .
COPY roast66/package-lock.json .
RUN npm ci

# Copy the source code and .env file
COPY roast66/ .
RUN npm run build

# Stage 2: Serve with Nginx
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY roast66/public/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
