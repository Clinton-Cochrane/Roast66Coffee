# Frontend API base URL (no trailing slash)
VITE_API_URL=http://localhost:5001/api
# Localhost uses public/data/menu.json by default. Set false to force API-backed menu reads.
# VITE_USE_STATIC_MENU=false
# Enables the configured online payment provider on Place Order and Order Status.
VITE_ENABLE_ONLINE_PAYMENTS=false
# Optional: VAPID public key for web push (admin/staff prompts); must match API Push__VapidPublicKey.
# VITE_VAPID_PUBLIC_KEY=
